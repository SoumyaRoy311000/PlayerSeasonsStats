<UserControl x:Class="LMStudioClone.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Chat Messages -->
        <ScrollViewer Grid.Row="0" x:Name="ChatScrollViewer" 
                      VerticalScrollBarVisibility="Auto"
                      Padding="10">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5" Padding="10" 
                                Background="{Binding IsUser, Converter={StaticResource MessageBackgroundConverter}}"
                                CornerRadius="8"
                                HorizontalAlignment="{Binding IsUser, Converter={StaticResource MessageAlignmentConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" FontSize="12" 
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" 
                                           FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Generation Parameters -->
        <Expander Grid.Row="1" Header="Generation Parameters" Margin="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Temperature" FontSize="12"/>
                    <Slider Value="{Binding Temperature}" Minimum="0" Maximum="2" 
                            TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding Temperature, StringFormat='{}{0:F1}'}" 
                               FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Max Tokens" FontSize="12"/>
                    <Slider Value="{Binding MaxTokens}" Minimum="1" Maximum="4096" 
                            TickFrequency="64" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding MaxTokens, StringFormat='{}{0:F0}'}" 
                               FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="5">
                    <TextBlock Text="Top P" FontSize="12"/>
                    <Slider Value="{Binding TopP}" Minimum="0" Maximum="1" 
                            TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding TopP, StringFormat='{}{0:F2}'}" 
                               FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Expander>

        <!-- Input Area -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="MessageInput" Grid.Column="0" 
                     Text="{Binding CurrentMessage, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MaxHeight="100" VerticalScrollBarVisibility="Auto"
                     Padding="10" FontSize="14"
                     ui:ControlHelper.PlaceholderText="Type your message here..."/>

            <Button Grid.Column="1" Content="Send" Margin="5,0,0,0" Padding="15,10"
                    Command="{Binding SendMessageCommand}"
                    IsEnabled="{Binding CanSendMessage}"/>
        </Grid>
    </Grid>
</UserControl>

